# Spring profiles
SPRING_PROFILES_ACTIVE=dev

# Database (PostgreSQL) - change these for local dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/springcinema
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=password

# Testcontainers (optional)
TESTCONTAINERS_RYUK_DISABLED=false

# JWT secret — MUST be changed in production (use a long random string, min 256 bits)
APP_JWT_SECRET=change-me-in-production-use-a-long-random-string-at-least-32-chars

# CORS origins (comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173
